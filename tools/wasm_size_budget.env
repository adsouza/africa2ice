# Compressed-wasm size budget. These are the two Appendix C configuration rows
# that govern the release transfer-size gate, kept in one file so that
# tools/check_wasm_size.sh, the CI workflow, and a developer running the check
# locally all read the same numbers instead of repeating a literal.
#
#   MaxCompressedWasmBytes   Policy, tighten only (smaller ceiling)
#   CompressedWasmHeadroom   Policy, tighten only (smaller headroom)
#
# DESIGN.md §10 requires the ceiling to be ratcheted DOWN to the measured
# release build's Brotli size plus the headroom, and the direction rule keeps
# that one-way: "a ceiling that can only fall is a growth detector; one that may
# rise on demand is a number that records whatever the build happens to weigh."
#
# Raising MaxCompressedWasmBytes is a reviewed manifest change, and never a way
# to make a failing build pass. check_wasm_size.sh refuses any value above the
# Appendix C original recorded below, so the one-way property is mechanical
# rather than a convention.

# Appendix C's original pre-implementation ceiling, derived from the dependency
# skeleton rather than from this game. It is the absolute upper bound; the live
# ceiling may only sit at or below it.
AppendixCOriginalCeiling=5500000

# Ratcheted 2026-08-30 from a stripped, trimmed js/wasm build measured with
# `brotli -q 11` (3_502_025 bytes), plus the headroom, rounded up to the next
# 50_000. That measurement was taken without `wasm-opt`, which §2 notes "is not
# the size lever it looks like" because it optimizes decompressed size and
# startup rather than transfer size. The web-release job re-measures the true
# optimized build on NativeBenchmarkReference and fails with the exact
# replacement value if this ceiling is stale.
MaxCompressedWasmBytes=4050000

CompressedWasmHeadroom=500000

# Granularity the ratchet target is rounded up to, so that a few kilobytes of
# build-to-build drift does not churn the checked-in ceiling.
RatchetQuantum=50000
